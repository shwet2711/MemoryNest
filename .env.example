APP_NAME=MemoryNest
APP_ENV=development
DEBUG=True

DATABASE_URL=sqlite:///./data/memorynest.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

CHROMA_PERSIST_DIRECTORY=./data/chroma

UPLOAD_DIRECTORY=./data/uploads
PROCESSED_DIRECTORY=./data/processed
MEMORYNEST_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORYNEST_CHROMA_PATH=data/chroma
MEMORYNEST_CHROMA_COLLECTION=memorynest_documents