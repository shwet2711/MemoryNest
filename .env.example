APP_NAME=MemoryNest
APP_ENV=development
DEBUG=True

DATABASE_URL=sqlite:///./data/memorynest.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

CHROMA_PERSIST_DIRECTORY=./data/chroma

UPLOAD_DIRECTORY=./data/uploads
PROCESSED_DIRECTORY=./data/processed

MEMORYNEST_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORYNEST_CHROMA_PATH=data/chroma
MEMORYNEST_CHROMA_COLLECTION=memorynest_documents

# RAG quality settings
# Chroma cosine distance: lower means more similar.
MEMORYNEST_RAG_MAX_DISTANCE=0.70

# Maximum characters of retrieved context sent to Ollama.
MEMORYNEST_RAG_MAX_CONTEXT_CHARS=12000

NEO4J_ENABLED=False
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j